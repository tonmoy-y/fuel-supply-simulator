# No secrets are required. Copy to .env and adjust.
SIM_BASE_URL=http://localhost:8000
SIM_TIMEOUT_S=3
SIM_MAX_RETRIES=3
REFRESH_INTERVAL_S=2
STALE_AFTER_S=15
AUTOPILOT=false                 # true => executes only non-review recommendations while data is fresh
OPERATOR_TOKEN=                 # set to require X-Operator-Token on mutating endpoints
ENABLE_ADMIN_PROXY=false        # demo-only run/pause/step pass-through (never exposes reset)
LOG_LEVEL=INFO
